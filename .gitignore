node_modules/
dist/
.env
logs/
*.log
.DS_Store
.claude/worktrees/
learnings.md
# Deliberately-local docs (proposals, scratch notes) — a broad `git add docs/`
# must never sweep these into a public branch.
*.local.md
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Runtime migration/export artifacts can contain authoritative memory text and
# large database backups. They must never be staged into the public repository.
/work/

# Derived entity profiles — character sketches of real people (person/repo/situation),
# written at consolidation time. Runtime data, never tracked. (Anchored to repo root so
# it does NOT match the src/memory/profiles/ source code.)
/memory/profiles/

# Notion PDF export output — contains real internal content, never tracked.
/notion-export*/

# Support config (operator-specific, never tracked)
support/repo-routing.yaml
support/admin-credentials.yaml
# Bug pipeline runtime artifacts — contain real user data (emails, member IDs)
support/bugs/
.playwright-mcp/
tmp/
